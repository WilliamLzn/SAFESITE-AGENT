# SAFESITE-AGENT — plantilla de credenciales (copiar a .env y llenar)
# .env está en .gitignore: NUNCA subir credenciales reales al repositorio.
# El actuador funciona sin credenciales en modo DRY-RUN (construye los
# mensajes y los registra, pero no envía).

# --- WhatsApp Business Cloud API (Meta Developers) ---
WHATSAPP_TOKEN=token_de_system_user_permanente
WHATSAPP_PHONE_ID=123456789012345
WHATSAPP_DESTINATARIO=573001234567

# --- App de Meta para el webhook conversacional (INFO) ---
WHATSAPP_APP_ID=1234567890123456
WHATSAPP_APP_SECRET=secreto_de_la_app
WHATSAPP_WABA_ID=123456789012345
WEBHOOK_VERIFY_TOKEN=safesite_verify

# --- Ruta al binario cloudflared (opcional; si está en el PATH no hace falta) ---
# CLOUDFLARED_PATH=C:\ruta\a\cloudflared.exe
